; Fondwave Slate — the defaults applied when this look-and-feel is selected.
;
; Same shapes as Fond and Fondwave (the desktoptheme is shared and ships no
; colours file of its own, so it just picks up whichever scheme is active).
; The palette here is Fond's own neutral greys — FondwaveSlateLight/Dark keep
; every background exactly as FondLight/FondDark defines it — with Fondwave's
; indigo/berry/coral highlights standing in for Fond's Adwaita blue accent.
; Dark is available from System Settings → Colors → Fondwave Slate Dark.
;
; The widget style stays Breeze, quiet, exactly as Fond and Fondwave configure
; it — this is a different mood, not a different design language.

[kdeglobals][General]
ColorScheme=FondwaveSlateLight
Name=Fondwave Slate Light
widgetStyle=Breeze
accentColorFromWallpaper=false

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][Icons]
Theme=breeze

[plasmarc][Theme]
name=fond

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
BorderSize=None
BorderSizeAuto=false

[breezerc][Windeco]
DrawBackgroundGradient=false
DrawBorderOnMaximizedWindows=false
DrawTitleBarSeparator=true
TitleAlignment=AlignCenterFullWidth
ButtonSize=0
OutlineCloseButton=false

[breezerc][Style]
ToolBarDrawItemSeparator=false
SidePanelDrawFrame=false
DockWidgetDrawFrame=false
MenuItemDrawStrongFocus=false
ScrollBarAddLineButtons=0
ScrollBarSubLineButtons=0
SliderDrawTickMarks=false
TabBarDrawCenteredTabs=true
WindowDragMode=WD_FULL
