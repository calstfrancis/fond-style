# Fond Light — libadwaita's light palette, expressed as a Plasma colour scheme.
#
# Every value here is lifted from libadwaita's own named colours rather than
# invented, so a Qt or Plasma window sits on the desktop at exactly the same
# tone as Zerkalo, Rubric and the rest of the suite beside it. The mapping:
#
#   Colors:Window        @window_bg_color            #fafafb
#   Colors:View          @view_bg_color              #ffffff
#   Colors:Button        @card_bg_color              #ffffff
#   Colors:Header        @sidebar_bg_color           #ebebed   (see below)
#   Colors:Complementary @secondary_sidebar_bg_color #f3f3f5
#   Colors:Tooltip       @popover_bg_color           #ffffff
#   Selection            @accent_bg_color            #3584e4
#
# Header takes the *sidebar* colour, not Adwaita's @headerbar_bg_color. That is
# the same judgement fond.css records at the top of its Surfaces section:
# Adwaita's header bar is pure white in the light scheme, so using it gives no
# separation from the content at all. Chrome has to be the darker plane.
#
# Foregrounds resolve @window_fg_color — RGB(0 0 6 / 80%) — against the surface
# it sits on, since Plasma wants opaque values.

[ColorEffects:Disabled]
Color=250,250,251
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=140,140,143
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

